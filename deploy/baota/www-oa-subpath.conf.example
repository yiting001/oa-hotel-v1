# 将 OA 部署到已备案域名（www.pptpos.cn）的 /oa/ 子路径，不影响同域会员系统。
#
# 服务器准备（发布目录替换后软链仍然有效）：
#   ln -sfn /www/wwwroot/47.107.168.97_52175/oa-hotel-production \
#           /www/wwwroot/www.pptpos.cn/oa
#
# 把下面的 location 加入 www.pptpos.cn 的 server 块（放在 location / 之前），
# 然后执行 nginx -t && nginx -s reload。
# 前端使用相对 base，同一份构建同时支持根路径和 /oa/ 子路径。

    location = /oa {
        return 301 /oa/;
    }

    location ^~ /oa/api/ {
        proxy_pass http://127.0.0.1:52176/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }

    location = /oa/sw.js {
        root /www/wwwroot/www.pptpos.cn;
        try_files $uri =404;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
        add_header Service-Worker-Allowed "/oa/" always;
    }

    location = /oa/manifest.webmanifest {
        root /www/wwwroot/www.pptpos.cn;
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /oa/offline.html {
        root /www/wwwroot/www.pptpos.cn;
        try_files $uri =404;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /oa/assets/ {
        root /www/wwwroot/www.pptpos.cn;
        try_files $uri =404;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /oa/ {
        root /www/wwwroot/www.pptpos.cn;
        index index.html;
        try_files $uri $uri/ /oa/index.html;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
    }
