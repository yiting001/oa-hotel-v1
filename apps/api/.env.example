OA_DATABASE_PATH=data/oa.sqlite
# 附件与文件库的落盘目录，默认 ./storage；生产环境请指向持久化目录
OA_STORAGE_PATH=storage
JWT_SECRET=replace-with-a-random-secret
OA_LOGIN_MAX_FAILURES=5
OA_LOGIN_LOCK_MS=900000
OA_LOGIN_MAX_TRACKED_ACCOUNTS=10000
OA_DEMO_PASSWORD=replace-for-local-development
OA_DEMO_SEED=false
OA_BOOTSTRAP_ADMIN_USERNAME=office
OA_TIME_ZONE=Asia/Shanghai
OA_SWAGGER_ENABLED=true
OA_CORS_ORIGINS=
HOST=0.0.0.0
PORT=3000
